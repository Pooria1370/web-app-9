{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-9",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "105bff1c-7f05-4cc9-852f-eefef0a20c8f","database_name": "quiet-fern-d8ae-db" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "96313497598449e8b0cc69f63fdde162" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
